---
import Layout from '../layouts/Layout.astro';
---

<Layout title="32 Security - Professional Security Solutions">
  <main class="container mx-auto px-4 py-8">
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold text-af-blue mb-4">Advanced Cybersecurity Solutions</h1>
      <p class="text-xl text-af-silver mb-8">Empowering Organizations Through Expert Security Training and Consulting</p>
      <div class="flex justify-center space-x-4">
        <a href="/contact" class="bg-af-blue text-af-white px-8 py-3 rounded-lg hover:bg-opacity-90">
          Get Started
        </a>
        <a href="/services" class="border-2 border-af-blue text-af-blue px-8 py-3 rounded-lg hover:bg-af-silver hover:bg-opacity-10">
          Our Services
        </a>
      </div>
    </section>

    <section class="grid md:grid-cols-3 gap-8 mb-16">
      <div class="bg-af-silver bg-opacity-10 p-6 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Cybersecurity Consulting</h2>
        <p class="text-af-blue">Expert guidance in threat assessment, vulnerability management, and security architecture design.</p>
      </div>
      <div class="bg-af-silver bg-opacity-10 p-6 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Security Education</h2>
        <p class="text-af-blue">Comprehensive training programs for organizations and security professionals.</p>
      </div>
      <div class="bg-af-silver bg-opacity-10 p-6 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">24/7 Threat Monitoring</h2>
        <p class="text-af-blue">Advanced cybersecurity surveillance and incident response.</p>
      </div>
    </section>

    <section class="bg-af-silver bg-opacity-5 p-8 rounded-lg mb-16">
      <h2 class="text-3xl font-bold mb-6 text-center">Our Mission</h2>
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-lg mb-6">
          At 32 Security, we are committed to advancing the field of cybersecurity through 
          expert consulting and comprehensive education programs. Our team of certified 
          professionals brings military-grade expertise to the private sector.
        </p>
        <p class="text-lg">
          We specialize in preparing organizations for the evolving landscape of cyber threats, 
          combining advanced technical knowledge with practical, real-world experience in 
          defensive and offensive security operations.
        </p>
      </div>
    </section>

    <section class="text-center mb-16">
      <h2 class="text-3xl font-bold mb-8">Why Choose Us</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-bold mb-2">Military-Grade Expertise</h3>
          <p class="text-af-blue">Drawing from extensive experience in advanced security operations.</p>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-2">Industry Leadership</h3>
          <p class="text-af-blue">Setting standards in cybersecurity education and consulting.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>