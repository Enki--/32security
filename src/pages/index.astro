---
import Layout from '../layouts/Layout.astro';
---

<Layout title="32 Security - Professional Security Solutions">
  <main class="container mx-auto px-4 py-8">
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold text-af-blue mb-4">Professional Security Solutions</h1>
      <p class="text-xl text-af-silver mb-8">Protecting What Matters Most</p>
      <a href="/contact" class="bg-af-blue text-af-white px-8 py-3 rounded-lg hover:bg-opacity-90">
        Get Started
      </a>
    </section>

    <section class="grid md:grid-cols-3 gap-8 mb-16">
      <div class="bg-af-silver bg-opacity-10 p-6 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Security Consulting</h2>
        <p class="text-af-blue">Expert guidance to protect your assets and interests.</p>
      </div>
      <div class="bg-af-silver bg-opacity-10 p-6 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Risk Assessment</h2>
        <p class="text-af-blue">Comprehensive evaluation of security vulnerabilities.</p>
      </div>
      <div class="bg-af-silver bg-opacity-10 p-6 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">24/7 Monitoring</h2>
        <p class="text-af-blue">Round-the-clock security surveillance and response.</p>
      </div>
    </section>

    <section class="text-center mb-16">
      <h2 class="text-3xl font-bold mb-8">Why Choose Us</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-bold mb-2">Experience</h3>
          <p class="text-af-blue">Years of expertise in security solutions.</p>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-2">Reliability</h3>
          <p class="text-af-blue">Trusted by businesses and organizations.</p>
        </div>
      </div>
    </section>
  </main>
</Layout>