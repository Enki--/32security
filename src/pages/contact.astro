---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - 32 Security">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-af-blue mb-8 text-center">Contact Us</h1>
    
    <div class="max-w-2xl mx-auto bg-af-silver bg-opacity-10 p-8 rounded-lg">
      <p class="text-center mb-8">Click the button below to send us an email directly:</p>
      
      <a 
        href="mailto:info@32security.com?subject=32%20Security%20Inquiry"
        class="block w-full bg-af-blue text-af-white py-3 rounded-lg hover:bg-opacity-90 transition-colors text-center"
      >
        Send us an Email
      </a>
    </div>

    <div class="mt-12 text-center">
      <h2 class="text-2xl font-bold text-af-blue mb-4">Contact Information</h2>
      <div class="space-y-2">
        <p>Email: info@32security.com</p>
        <p>Phone: (555) 123-4567</p>
        <p>Hours: Monday - Friday, 9:00 AM - 5:00 PM EST</p>
      </div>
    </div>
  </main>
</Layout>