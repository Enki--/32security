---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services - 32 Security">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-af-blue mb-8 text-center">Our Services</h1>
    
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <div class="bg-af-silver bg-opacity-10 p-8 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Cybersecurity Consulting</h2>
        <ul class="space-y-3">
          <li>• Advanced threat modeling and assessment</li>
          <li>• Zero-trust architecture design</li>
          <li>• Security program development</li>
          <li>• Advanced persistent threat (APT) defense strategies</li>
        </ul>
      </div>

      <div class="bg-af-silver bg-opacity-10 p-8 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Security Education</h2>
        <ul class="space-y-3">
          <li>• Offensive security training</li>
          <li>• Defensive operations workshops</li>
          <li>• Incident response drills</li>
          <li>• Advanced penetration testing courses</li>
        </ul>
      </div>

      <div class="bg-af-silver bg-opacity-10 p-8 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Threat Intelligence</h2>
        <ul class="space-y-3">
          <li>• Real-time threat monitoring</li>
          <li>• Intelligence gathering and analysis</li>
          <li>• Vulnerability assessment</li>
          <li>• Strategic defense planning</li>
        </ul>
      </div>

      <div class="bg-af-silver bg-opacity-10 p-8 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Security Operations</h2>
        <ul class="space-y-3">
          <li>• SOC team training</li>
          <li>• Incident response planning</li>
          <li>• Red team operations</li>
          <li>• Blue team defense strategies</li>
        </ul>
      </div>
    </div>

    <div class="bg-af-silver bg-opacity-5 p-8 rounded-lg mb-16">
      <h2 class="text-3xl font-bold mb-6 text-center">Our Expertise</h2>
      <p class="text-center mb-8">
        Our team brings military-grade cybersecurity expertise to the private sector, 
        offering comprehensive consulting and education services that prepare organizations 
        for tomorrow's security challenges.
      </p>
    </div>

    <div class="text-center">
      <a href="/contact" class="bg-af-blue text-af-white px-8 py-3 rounded-lg hover:bg-opacity-90 inline-block">
        Request a Consultation
      </a>
    </div>
  </main>
</Layout>