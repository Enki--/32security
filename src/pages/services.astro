---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services - 32 Security">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-af-blue mb-8 text-center">Our Services</h1>
    
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <div class="bg-af-silver bg-opacity-10 p-8 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Security Consulting</h2>
        <ul class="space-y-3">
          <li>• Security program development</li>
          <li>• Policy and procedure creation</li>
          <li>• Security awareness training</li>
          <li>• Compliance assessment</li>
        </ul>
      </div>

      <div class="bg-af-silver bg-opacity-10 p-8 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Risk Assessment</h2>
        <ul class="space-y-3">
          <li>• Threat analysis</li>
          <li>• Vulnerability assessment</li>
          <li>• Security audits</li>
          <li>• Mitigation strategies</li>
        </ul>
      </div>

      <div class="bg-af-silver bg-opacity-10 p-8 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">24/7 Monitoring</h2>
        <ul class="space-y-3">
          <li>• Real-time surveillance</li>
          <li>• Incident response</li>
          <li>• Alert management</li>
          <li>• Security reporting</li>
        </ul>
      </div>

      <div class="bg-af-silver bg-opacity-10 p-8 rounded-lg">
        <h2 class="text-2xl font-bold mb-4">Special Projects</h2>
        <ul class="space-y-3">
          <li>• Custom security solutions</li>
          <li>• Event security</li>
          <li>• Executive protection</li>
          <li>• Emergency response planning</li>
        </ul>
      </div>
    </div>

    <div class="text-center">
      <a href="/contact" class="bg-af-blue text-af-white px-8 py-3 rounded-lg hover:bg-opacity-90 inline-block">
        Request a Consultation
      </a>
    </div>
  </main>
</Layout>